{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window dragging for the overlay title bar, and cmd +/- page zoom",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:5173/*"] },
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:webview:allow-set-webview-zoom"]
}
