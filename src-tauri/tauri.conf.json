{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slim",
  "version": "0.2.0",
  "identifier": "se.aspace.slim",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../slim",
    "beforeDevCommand": "python3 -m http.server 5173 --bind 127.0.0.1 --directory slim"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "url": "http://127.0.0.1:5173",
        "title": "slim",
        "width": 1000,
        "height": 640,
        "minWidth": 640,
        "minHeight": 380,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Minimal Spotify player",
    "longDescription": "A minimal, text-only Spotify player. Requires Spotify Premium and your own Spotify developer Client ID.",
    "copyright": "Copyright (c) 2026 Stefan Larsson",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
